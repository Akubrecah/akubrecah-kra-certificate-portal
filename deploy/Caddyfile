    # Automatically manages Let's Encrypt / ZeroSSL certificates
    email poweldayck@gmail.com
}

# Main Agency & Technology Portal
akubrecah.com, www.akubrecah.com {
    encode gzip zstd

    reverse_proxy akubrecah-app:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }
}

