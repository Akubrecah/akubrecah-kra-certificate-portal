# ============================================================
# Akubrecah Enterprise & KRA Portal — Environment Variables
# Copy this to .env and fill in your production values
# ============================================================

# --- Database & Prisma (Supabase / PostgreSQL) ---
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# --- Clerk Authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
SUPER_ADMIN_EMAIL=poweldayck@gmail.com
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=poweldayck@gmail.com

# --- Supabase Client ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI Models ---
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# --- WhatsApp (Evolution API) ---
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=akubrecah_secret_whatsapp_key_2026
EVOLUTION_INSTANCE_NAME=akubrecah-kra
ADMIN_WHATSAPP_NUMBERS=254712345678,254700000000
ADMIN_BOT_PIN=8426
WEBHOOK_GLOBAL_URL=https://akubrecah.com/api/whatsapp/webhook

# --- n8n Workflow Automation ---
N8N_KRA_DELIVERY_WEBHOOK=https://n8n.vybeafrica.org/webhook/kra-delivery

# --- Security ---
ENCRYPTION_KEY=generate-a-strong-random-string-min-32-chars
JWT_SECRET=generate-another-strong-random-string
HMAC_SECRET=generate-yet-another-strong-random-string

# --- Application URLs ---
NEXT_PUBLIC_APP_URL=https://akubrecah.com
NODE_ENV=production

# --- KRA Official Live API Integration ---
KRA_API_BASE_URL=https://api.kra.go.ke
KRA_PIN_CONSUMER_KEY=your-kra-pin-consumer-key
KRA_PIN_CONSUMER_SECRET=your-kra-pin-consumer-secret
KRA_ID_CONSUMER_KEY=your-kra-id-consumer-key
KRA_ID_CONSUMER_SECRET=your-kra-id-consumer-secret

# --- M-Pesa (Optional) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# --- Paystack Integration (Cards, Apple Pay, M-Pesa) ---
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SUBSCRIPTION_AMOUNT_KES=499
PAYSTACK_DOWNLOAD_FEE_KES=30

# --- Redis Cache & Rate Limiting ---
REDIS_URL=redis://redis:6379
