generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(uuid())
  clerkId       String    @unique
  email         String    @unique
  firstName     String?
  lastName      String?
  profileImage  String?
  lastLogin     DateTime? @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String    @default("user") // "user", "admin"
  activities    UserActivity[]

  @@map("users")
}

model UserActivity {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityType String   @map("activity_type") // e.g., 'login', 'file_return', 'update_profile'
  description  String?
  status       String   @default("success") // 'success', 'error', 'warning', 'info'
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("user_activities")
}

model ServiceSetting {
  id          String   @id @default(uuid())
  serviceKey  String   @unique @map("service_key")
  serviceName String   @map("service_name")
  isActive    Boolean  @default(true) @map("is_active")
  description String?
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("service_settings")
}

model AIConversation {
  id             String    @id @default(uuid())
  channel        String    // 'whatsapp', 'web', 'api'
  externalId     String?   @map("external_id")
  userName       String?   @map("user_name")
  userEmail      String?   @map("user_email")
  userPhone      String?   @map("user_phone")
  modelUsed      String?   @map("model_used")
  messages       Json      @default("[]")
  contextSummary String?   @map("context_summary")
  tokenCount     Int       @default(0) @map("token_count")
  status         String    @default("active")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  tasks          AITask[]
  tickets        Ticket[]

  @@map("ai_conversations")
}

model AITask {
  id             String         @id @default(uuid())
  conversationId String?        @map("conversation_id")
  conversation   AIConversation? @relation(fields: [conversationId], references: [id])
  parentTaskId   String?        @map("parent_task_id")
  parentTask     AITask?        @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  childTasks     AITask[]       @relation("TaskHierarchy")
  agentType      String         @map("agent_type")
  taskType       String         @map("task_type")
  priority       String         @default("medium")
  status         String         @default("queued")
  inputData      Json           @default("{}") @map("input_data")
  outputData     Json           @default("{}") @map("output_data")
  errorMessage   String?        @map("error_message")
  retryCount     Int            @default(0) @map("retry_count")
  maxRetries     Int            @default(3) @map("max_retries")
  dependencies   String[]       @default([])
  assignedAt     DateTime?      @map("assigned_at")
  startedAt      DateTime?      @map("started_at")
  completedAt    DateTime?      @map("completed_at")
  deadline       DateTime?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")
  logs           AITaskLog[]
  tickets        Ticket[]

  @@map("ai_tasks")
}

model AITaskLog {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  task      AITask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  logLevel  String   @default("info") @map("log_level")
  message   String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_task_logs")
}

model Ticket {
  id                    String          @id @default(uuid())
  conversationId        String?         @map("conversation_id")
  conversation          AIConversation? @relation(fields: [conversationId], references: [id])
  taskId                String?         @map("task_id")
  task                  AITask?         @relation(fields: [taskId], references: [id])
  ticketNumber          String          @unique @map("ticket_number")
  category              String
  priority              String          @default("medium")
  status                String          @default("open")
  subject               String
  description           String?
  requesterName         String?         @map("requester_name")
  requesterEmail        String?         @map("requester_email")
  requesterPhone        String?         @map("requester_phone")
  assignedTo            String?         @map("assigned_to")
  escalationLevel       Int             @default(0) @map("escalation_level")
  slaResponseDeadline   DateTime?      @map("sla_response_deadline")
  slaResolutionDeadline DateTime?      @map("sla_resolution_deadline")
  firstResponseAt       DateTime?      @map("first_response_at")
  resolvedAt            DateTime?      @map("resolved_at")
  resolutionNotes       String?         @map("resolution_notes")
  tags                  String[]        @default([])
  metadata              Json            @default("{}")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at")
  messages              TicketMessage[]

  @@map("tickets")
}

model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType String   @map("sender_type")
  senderName String?  @map("sender_name")
  message    String
  attachments Json     @default("[]")
  isInternal Boolean  @default(false) @map("is_internal")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("ticket_messages")
}

model Session {
  id           String            @id @default(uuid())
  pin          String?
  status       String            @default("prospect") // "prospect", "active", "completed", "failed"
  currentStep  Int               @default(1) @map("current_step")
  deviceInfo   Json?             @map("device_info")
  ipAddress    String?           @map("ip_address")
  userAgent    String?           @map("user_agent")
  isMobile     Boolean           @default(false) @map("is_mobile")
  formData     Json              @default("{}") @map("form_data")
  lastActivity DateTime          @default(now()) @map("last_activity")
  completedAt  DateTime?         @map("completed_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  activities   SessionActivity[]
  userId       String?           @map("user_id")

  @@map("sessions")
}

model SessionActivity {
  id           String   @id @default(uuid())
  sessionId    String   @map("session_id")
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  activityType String   @map("activity_type")
  description  String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("session_activities")
}

model BlogPost {
  id        String   @id @default(uuid())
  title     String
  date      String   // Using string to match the requested format YYYY.MM.DD
  excerpt   String
  content   String   @db.Text
  image     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("blog_posts")
}

model AppSetting {
  id          String   @id @default(uuid())
  category    String   // e.g., 'api', 'tax', 'general'
  settingKey  String   @unique @map("setting_key")
  value       Json     @default("{}")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_settings")
}

model JobPosition {
  id                      String   @id @default(uuid())
  title                   String
  location                String
  type                    String
  department              String
  jobNumber               String   @unique @map("job_number")
  worksite                String
  travel                  String
  roleType                String   @map("role_type")
  profession              String
  discipline              String
  employmentType          String   @map("employment_type")
  datePosted              String   @map("date_posted")
  description             String   @db.Text
  overview                String[]
  responsibilities        String[]
  requiredQualifications  String[] @map("required_qualifications")
  preferredQualifications String[] @map("preferred_qualifications")
  additionalRequirements  String[] @map("additional_requirements")
  compensation            String
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("job_positions")
}
