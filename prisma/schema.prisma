generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ai_conversations {
  id              String     @id
  channel         String
  external_id     String?
  user_name       String?
  user_email      String?
  user_phone      String?
  model_used      String?
  messages        Json       @default("[]")
  context_summary String?
  token_count     Int        @default(0)
  status          String     @default("active")
  metadata        Json       @default("{}")
  created_at      DateTime   @default(now())
  updated_at      DateTime   @default(now())
  ai_tasks        ai_tasks[]
  tickets         tickets[]
}

model ai_task_logs {
  id         String   @id
  task_id    String
  log_level  String   @default("info")
  message    String
  metadata   Json     @default("{}")
  created_at DateTime @default(now())
  ai_tasks   ai_tasks @relation(fields: [task_id], references: [id], onDelete: Cascade)
}

model ai_tasks {
  id               String            @id
  conversation_id  String?
  parent_task_id   String?
  agent_type       String
  task_type        String
  priority         String            @default("medium")
  status           String            @default("queued")
  input_data       Json              @default("{}")
  output_data      Json              @default("{}")
  error_message    String?
  retry_count      Int               @default(0)
  max_retries      Int               @default(3)
  dependencies     String[]          @default([])
  assigned_at      DateTime?
  started_at       DateTime?
  completed_at     DateTime?
  deadline         DateTime?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @default(now())
  ai_task_logs     ai_task_logs[]
  ai_conversations ai_conversations? @relation(fields: [conversation_id], references: [id])
  ai_tasks         ai_tasks?         @relation("ai_tasksToai_tasks", fields: [parent_task_id], references: [id])
  other_ai_tasks   ai_tasks[]        @relation("ai_tasksToai_tasks")
  tickets          tickets[]
}

model app_settings {
  id          String   @id
  category    String
  setting_key String   @unique
  value       Json     @default("{}")
  updated_at  DateTime @default(now())
}

model blog_posts {
  id         String   @id
  title      String
  date       String
  excerpt    String
  content    String
  image      String?
  created_at DateTime @default(now())
  updated_at DateTime
}

model job_positions {
  id                      String   @id
  title                   String
  location                String?
  type                    String?
  department              String?
  jobNumber               String?  @unique
  worksite                String?
  travel                  String?
  roleType                String?
  profession              String?
  discipline              String?
  employmentType          String?
  datePosted              String?
  description             String?
  overview                String[] @default([])
  responsibilities        String[] @default([])
  requiredQualifications  String[] @default([])
  preferredQualifications String[] @default([])
  additionalRequirements  String[] @default([])
  compensation            String?
  created_at              DateTime @default(now())
  updated_at              DateTime @default(now())
}

model kra_pin_cache {
  id              String   @id
  pin             String   @unique
  id_number       String?
  name            String
  email           String?
  building        String?
  street          String?
  city            String?
  county          String?
  district        String?
  tax_area        String?
  po_box          String?
  postal_code     String?
  station         String?
  phone_number    String?
  registered_date String?
  created_at      DateTime @default(now())
  updated_at      DateTime

  @@index([id_number])
}

model service_settings {
  id           String   @id
  service_key  String   @unique
  service_name String
  is_active    Boolean  @default(true)
  description  String?
  updated_at   DateTime @default(now())
}

model session_activities {
  id            String   @id
  session_id    String
  activity_type String
  description   String?
  metadata      Json     @default("{}")
  created_at    DateTime @default(now())
  sessions      sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)
}

model sessions {
  id                 String               @id
  pin                String?
  status             String               @default("prospect")
  current_step       Int                  @default(1)
  device_info        Json?
  ip_address         String?
  user_agent         String?
  is_mobile          Boolean              @default(false)
  form_data          Json                 @default("{}")
  last_activity      DateTime             @default(now())
  completed_at       DateTime?
  created_at         DateTime             @default(now())
  user_id            String?
  session_activities session_activities[]
}

model ticket_messages {
  id          String   @id
  ticket_id   String
  sender_type String
  sender_name String?
  message     String
  attachments Json     @default("[]")
  is_internal Boolean  @default(false)
  metadata    Json     @default("{}")
  created_at  DateTime @default(now())
  tickets     tickets  @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
}

model tickets {
  id                      String            @id
  conversation_id         String?
  task_id                 String?
  ticket_number           String            @unique
  category                String
  priority                String            @default("medium")
  status                  String            @default("open")
  subject                 String
  description             String?
  requester_name          String?
  requester_email         String?
  requester_phone         String?
  assigned_to             String?
  escalation_level        Int               @default(0)
  sla_response_deadline   DateTime?
  sla_resolution_deadline DateTime?
  first_response_at       DateTime?
  resolved_at             DateTime?
  resolution_notes        String?
  tags                    String[]          @default([])
  metadata                Json              @default("{}")
  created_at              DateTime          @default(now())
  updated_at              DateTime          @default(now())
  ticket_messages         ticket_messages[]
  ai_conversations        ai_conversations? @relation(fields: [conversation_id], references: [id])
  ai_tasks                ai_tasks?         @relation(fields: [task_id], references: [id])
}

model user_activities {
  id            String   @id
  user_id       String
  activity_type String
  description   String?
  status        String   @default("success")
  metadata      Json     @default("{}")
  created_at    DateTime @default(now())
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model users {
  id                    String                 @id
  clerkId               String                 @unique
  email                 String                 @unique
  firstName             String?
  lastName              String?
  profileImage          String?
  lastLogin             DateTime?              @default(now())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime
  role                  String                 @default("user")
  user_activities       user_activities[]
  subscriptions         Subscription[]
  certificate_downloads CertificateDownload[]
}

/// Monthly certificate download subscription for a user
model Subscription {
  id              String    @id @default(uuid())
  userId          String
  clerkId         String
  status          String    @default("active") // "active" | "expired" | "cancelled"
  planName        String    @default("monthly")
  amountPaid      Float     @default(0)
  currency        String    @default("KES")
  mpesaReceipt    String?   // M-Pesa receipt for the subscription payment
  startsAt        DateTime  @default(now())
  expiresAt       DateTime
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  users           users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clerkId])
  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

/// Records each certificate download — either via subscription or pay-per-download
model CertificateDownload {
  id              String    @id @default(uuid())
  userId          String
  clerkId         String
  pin             String    // KRA PIN that was downloaded
  downloadType    String    // "subscription" | "pay_per_download"
  amountCharged   Float     @default(0)
  currency        String    @default("KES")
  mpesaReceipt    String?   // M-Pesa receipt number (null for subscription downloads)
  checkoutId      String?   @unique // Daraja CheckoutRequestID — enforces one-download per payment
  subscriptionId  String?
  createdAt       DateTime  @default(now())
  users           users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clerkId])
  @@index([userId])
  @@index([pin])
  @@index([checkoutId])
  @@map("certificate_downloads")
}

/// Cyber Cafe registered for monthly KES 500 unlimited PIN retrieval package
model CyberCafe {
  id               String         @id @default(uuid())
  cafeName         String
  ownerName        String
  whatsappPhone    String         @unique // Formatted phone: 254XXXXXXXXX
  paymentPhone     String         // Safaricom phone: 254XXXXXXXXX
  status           String         @default("active") // "active" | "expired" | "pending"
  startsAt         DateTime?      @default(now())
  expiresAt        DateTime?
  totalDownloads   Int            @default(0)
  dailyDownloads   Int            @default(0)
  lastDownloadDate String?        // "YYYY-MM-DD" for 100/day fair-use tracking
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  invoices         CyberInvoice[]

  @@index([whatsappPhone])
  @@index([status])
  @@map("cyber_cafes")
}

/// Official Tax Invoices generated for Cyber Cafe subscriptions
model CyberInvoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique // e.g. INV-CYBER-2026-08426
  cyberCafeId   String
  cyberCafe     CyberCafe @relation(fields: [cyberCafeId], references: [id], onDelete: Cascade)
  amount        Float     @default(500)
  currency      String    @default("KES")
  mpesaReceipt  String?
  checkoutId    String?
  status        String    @default("paid") // "paid" | "pending"
  periodStart   DateTime
  periodEnd     DateTime
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([cyberCafeId])
  @@index([invoiceNumber])
  @@map("cyber_invoices")
}

model SystemLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  level     String   // "info" | "warning" | "error"
  service   String
  message   String
  actor     String
  ip        String
  details   Json?

  @@map("system_logs")
}

model Project {
  id                    String    @id @default(uuid())
  slug                  String    @unique
  title                 String
  summary               String
  description           String    @db.Text
  category              String    // "Full-Stack SaaS", "Fintech / Payments", "GovTech & Compliance", "Mobile Ecosystem"
  client                String?
  featuredImage         String
  galleryImages         String[]  @default([])
  liveUrl               String?
  githubUrl             String?
  technologies          String[]  @default([])
  problemStatement      String?   @db.Text
  solutionArchitecture  String?   @db.Text
  measurableOutcomes    String[]  @default([])
  isFeatured            Boolean   @default(false)
  isPublished           Boolean   @default(true)
  displayOrder          Int       @default(0)
  seoTitle              String?
  seoDescription        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isPublished])
  @@map("projects")
}

model Article {
  id                  String    @id @default(uuid())
  slug                String    @unique
  title               String
  excerpt             String
  content             String    @db.Text
  category            String
  tags                String[]  @default([])
  featuredImage       String?
  authorName          String    @default("Akubrecah")
  readingTimeMinutes  Int       @default(5)
  isPublished         Boolean   @default(true)
  publishedAt         DateTime  @default(now())
  seoTitle            String?
  seoDescription      String?
  canonicalUrl        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isPublished])
  @@map("articles")
}

model Inquiry {
  id          String        @id @default(uuid())
  name        String
  email       String
  phone       String?
  company     String?
  projectType String
  budget      String?
  message     String        @db.Text
  status      String        @default("new") // "new", "contacted", "qualified", "proposal_sent", "won", "lost", "archived"
  source      String        @default("website_contact")
  ipAddress   String?
  notes       InquiryNote[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}

model InquiryNote {
  id          String   @id @default(uuid())
  inquiryId   String
  authorName  String
  content     String   @db.Text
  createdAt   DateTime @default(now())
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@map("inquiry_notes")
}

model SkillCategory {
  id           String   @id @default(uuid())
  name         String   @unique
  displayOrder Int      @default(0)
  skills       Skill[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("skill_categories")
}

model Skill {
  id           String        @id @default(uuid())
  categoryId   String
  name         String
  proficiency  Int           @default(90) // 1 - 100 percentage
  iconName     String?
  yearsOfExp   Int?
  displayOrder Int           @default(0)
  category     SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([categoryId])
  @@map("skills")
}

model WorkExperience {
  id           String   @id @default(uuid())
  company      String
  role         String
  location     String?
  employmentType String? // "Full-time", "Contract", "Lead Consultant"
  startDate    String
  endDate      String?  // null or "Present"
  description  String   @db.Text
  achievements String[] @default([])
  technologies String[] @default([])
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("work_experiences")
}

model ServiceOffering {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  tagline      String
  description  String   @db.Text
  icon         String   @default("code")
  deliverables String[] @default([])
  technologies String[] @default([])
  priceStarting String?
  isFeatured   Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("service_offerings")
}

model Testimonial {
  id           String   @id @default(uuid())
  authorName   String
  authorTitle  String
  company      String
  avatarUrl    String?
  content      String   @db.Text
  isVerified   Boolean  @default(true)
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("testimonials")
}

model SiteSetting {
  id         String   @id @default(uuid())
  key        String   @unique
  value      Json
  updatedAt  DateTime @updatedAt

  @@map("site_settings")
}

model MediaAsset {
  id           String   @id @default(uuid())
  filename     String
  url          String
  mimeType     String
  sizeBytes    Int      @default(0)
  altText      String?
  category     String   @default("general") // "project", "article", "avatar", "document"
  createdAt    DateTime @default(now())

  @@index([category])
  @@map("media_assets")
}


